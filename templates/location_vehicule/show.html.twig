{% extends 'base.html.twig' %}

{% block title %}Location{% endblock %}

{% block body %}
    <h1>Location #{{ location_vehicule.id }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Client</th>
                <td>{{ location_vehicule.client }}</td>
            </tr>
            <tr>
                <th>Véhicule</th>
                <td>{{ location_vehicule.vehicule }} ({{ location_vehicule.vehicule.categorie }})</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ location_vehicule.dateDebut ? location_vehicule.dateDebut|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Date de fin prévue</th>
                <td>{{ location_vehicule.dateFinPrevue ? location_vehicule.dateFinPrevue|date('d/m/Y') : '' }}</td>
            </tr>
            <tr>
                <th>Date de retour effective</th>
                <td>{{ location_vehicule.dateRetourEffective ? location_vehicule.dateRetourEffective|date('d/m/Y') : 'Non rendu' }}</td>
            </tr>
            <tr>
                <th>Montant total</th>
                <td>{{ location_vehicule.montantTotal is not null ? location_vehicule.montantTotal ~ ' €' : '' }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Options</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Option</th>
                <th>Prix appliqué</th>
            </tr>
        </thead>
        <tbody>
        {% for lo in location_vehicule.locationOptions %}
            <tr>
                <td>{{ lo.option.nom }}</td>
                <td>{{ lo.prixApplique }} €</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">Aucune option</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_location_vehicule_index') }}">back to list</a>

    <a href="{{ path('app_location_vehicule_edit', {'id': location_vehicule.id}) }}">edit</a>

    {{ include('location_vehicule/_delete_form.html.twig') }}
{% endblock %}
